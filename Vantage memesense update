-- Aimbot
--------------------------------------------------------------------------
local function smoothK(s)
    return 1 / (1 + math.max(s, 0) * 0.2)
end

local function rnd(x)
    if x > 0 then return math.max(1, math.floor(x + 0.5)) end
    if x < 0 then return math.min(-1, math.ceil(x - 0.5)) end
    return 0
end

local function applyAim(part)
    local c = cam()
    if not c then return end
    local pos = part.Position
    if C.AimPredict > 0 then pos = pos + part.AssemblyLinearVelocity * C.AimPredict end
    local k = smoothK(C.AimSmooth)
    if C.AimMethod == "Camera" or not mousemoverel then
        c.CFrame = c.CFrame:Lerp(CFrame.lookAt(c.CFrame.Position, pos), k)
        return
    end
    if not mousemoverel then return end
    local sp = c:WorldToViewportPoint(pos)
    if sp.Z <= 0 then return end
    local d = Vector2.new(sp.X, sp.Y) - aimOrigin(C.AimFovOrigin)
    if d.Magnitude <= C.AimDead then return end
    local dx, dy = d.X * k * (C.AimAxisX / 100), d.Y * k * (C.AimAxisY / 100)
    if C.AimJitter > 0 then
        dx = dx + (math.random() - 0.5) * 2 * C.AimJitter
        dy = dy + (math.random() - 0.5) * 2 * C.AimJitter
    end
    local m = math.sqrt(dx * dx + dy * dy)
    if m > C.AimMaxStep and m > 0 then
        dx, dy = dx / m * C.AimMaxStep, dy / m * C.AimMaxStep
    end
    mousemoverel(rnd(dx), rnd(dy))
end

local function aimStep()
    if not C.AimOn then locked = nil return end
    if not (aimHeld or C.AimKey == "Sempre ativo") then locked = nil return end

    local tgt
    if C.AimLock and locked then
        local char = liveParts(locked)
        if char and ((not C.AimTeam) or isEnemy(locked)) then
            local info = pickTarget({
                fov = 179, part = C.AimPart, hitbox = false, team = C.AimTeam,
                wall = C.AimWall and C.AimLockBreakWall, maxDist = C.AimMaxDist,
                sort = C.AimSort, origin = C.AimFovOrigin, smokeIgnore = C.AimSmokeIgnore,
            }, locked)
            if info then tgt = info else locked = nil end
        else
            locked = nil
        end
    end
    if not tgt then
        tgt = pickTarget(aimOpts)
        if tgt and C.AimLock then locked = tgt.player end
    end
    if not tgt then return end

    local part = tgt.part
    if C.AimPart == "Mais proxima" then
        -- escolhe a parte mais perto da mira
        local c = cam()
        local origin = aimOrigin(C.AimFovOrigin)
        local bestD
        for _, pt in ipairs(tgt.list) do
            local sp = c:WorldToViewportPoint(pt.Position)
            local d = (Vector2.new(sp.X, sp.Y) - origin).Magnitude
            if not bestD or d < bestD then bestD = d part = pt end
        end
    end
    applyAim(part)
end

