local smokeSaved = {}
local effectSaved = {}
local TOGGLE_CLASSES = { ParticleEmitter = true, Smoke = true, Fire = true, Sparkles = true, Trail = true, Beam = true }

local function hideInst(d)
    if smokeSaved[d] then return end
    pcall(function()
        if d:IsA("BasePart") then
            smokeSaved[d] = { "Transparency", d.Transparency }
            d.Transparency = 1
        elseif d:IsA("Decal") or d:IsA("Texture") then
            smokeSaved[d] = { "Transparency", d.Transparency }
            d.Transparency = 1
        elseif TOGGLE_CLASSES[d.ClassName] then
            smokeSaved[d] = { "Enabled", d.Enabled }
            d.Enabled = false
        end
    end)
end

local function hideTree(root)
    hideInst(root)
    for _, d in ipairs(root:GetDescendants()) do hideInst(d) end
end

local function smokeRoot(d)
    local x = d
    for _ = 1, 6 do
        if not x or x == workspace then return nil end
        if CollectionService:HasTag(x, "VisionSmoke") then return x end
        if C.NoSmokeWalls and CollectionService:HasTag(x, "BlocksSight") then return x end
        x = x.Parent
    end
    return nil
end

local function restoreSmoke()
    for inst, data in pairs(smokeSaved) do
        pcall(function() inst[data[1]] = data[2] end)
    end
    smokeSaved = {}
end

local function scanSmoke()
    for _, t in ipairs(CollectionService:GetTagged("VisionSmoke")) do pcall(hideTree, t) end
    if C.NoSmokeWalls then
        for _, t in ipairs(CollectionService:GetTagged("BlocksSight")) do pcall(hideTree, t) end
    end
    task.spawn(function()
        local n = 0
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("ParticleEmitter") or d:IsA("Smoke") then
                if smokeRoot(d) or d.Name:lower():find("smoke") then hideInst(d) end
            end
            n = n + 1
            if n % 1500 == 0 then task.wait() end
        end
    end)
end

conn(CollectionService:GetInstanceAddedSignal("VisionSmoke"), function(i)
    if C.NoSmoke then task.defer(function() pcall(hideTree, i) end) end
end)
conn(CollectionService:GetInstanceAddedSignal("BlocksSight"), function(i)
    if C.NoSmoke and C.NoSmokeWalls then task.defer(function() pcall(hideTree, i) end) end
end)
conn(workspace.DescendantAdded, function(d)
    if not C.NoSmoke then return end
    if d:IsA("ParticleEmitter") or d:IsA("Smoke") or d:IsA("BasePart") then
        if smokeRoot(d) or ((d:IsA("ParticleEmitter") or d:IsA("Smoke")) and d.Name:lower():find("smoke")) then
            task.defer(function() hideInst(d) end)
        end
    end
end)

local function effectWanted(e)
    local cls = e.ClassName
    if C.NoBlur and (cls == "BlurEffect" or cls == "DepthOfFieldEffect") then return true end
    if C.NoColor and (cls == "ColorCorrectionEffect" or cls == "BloomEffect" or cls == "SunRaysEffect") then return true end
    return false
end

local function handleEffect(e)
    if not e:IsA("PostEffect") then return end
    if e.Name == "Stun" and C.NoFlash then
        pcall(function() e.Enabled = false end)
        task.defer(function() pcall(function() e:Destroy() end) end)
        return
    end
    if effectWanted(e) then
        if effectSaved[e] == nil then effectSaved[e] = e.Enabled end
        e.Enabled = false
        conn(e:GetPropertyChangedSignal("Enabled"), function()
            if effectWanted(e) and e.Enabled then e.Enabled = false end
        end)
    end
end

local function scanEffects()
    for _, e in ipairs(Lighting:GetChildren()) do handleEffect(e) end
    local c = cam()
    if c then for _, e in ipairs(c:GetChildren()) do handleEffect(e) end end
end

local function restoreEffects()
    for e, en in pairs(effectSaved) do
        pcall(function() e.Enabled = en end)
    end
    effectSaved = {}
end

local watchedCam
local function watchCamera()
    local c = cam()
    if c and c ~= watchedCam then
        watchedCam = c
        conn(c.ChildAdded, handleEffect)
    end
end
watchCamera()
conn(Lighting.ChildAdded, handleEffect)
conn(workspace:GetPropertyChangedSignal("CurrentCamera"), function()
    watchCamera()
    scanEffects()
end)

