env.VH_Unload = function()
    C.Dead = true
    C.AimOn = false
    C.AsOn = false
    pcall(NX.restore)
    pcall(restoreMovement)
    pcall(restoreMods)
    pcall(restoreGunConfig)
    C.ChamsOn = false
    C.EspOn = false
    pcall(function() RunService:UnbindFromRenderStep(BIND) end)
    pcall(function() RunService:UnbindFromRenderStep("VH_CamRestore") end)
    pcall(function() RunService:UnbindFromRenderStep("VH_CamApply") end)
    for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
    Conns = {}
    for p in pairs(ESP) do destroyESP(p) end
    pcall(restoreSmoke)
    pcall(restoreEffects)
    pcall(function() Overlay:Destroy() end)
    pcall(function() Holder:Destroy() end)
    pcall(function() Rayfield:Destroy() end)
    env.VH_Unload = nil
end


