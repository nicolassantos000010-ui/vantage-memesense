        Name = "Vantage Memesense",
        LoadingTitle = "Vantage Memesense",
        LoadingSubtitle = T("Chams | ESP | Aim | Auto Shoot | Visuais"),
        ToggleUIKeybind = Enum.KeyCode.RightShift,
        ConfigurationSaving = { Enabled = false },
        KeySystem = false,
    })

    local function newTab(name) return wrapTab(Window:CreateTab(T(name), 4483362458)) end

    local function toggle(tab, name, key, cb)
        local el = tab:CreateToggle({
            Name = name, CurrentValue = C[key], Flag = "vh_" .. key,
            Callback = function(v)
                C[key] = v
                if cb then cb(v) end
                if v and REQ[key] then post(function() guard(key) end) end
            end,
        })
        UI[key] = { el = el, kind = "toggle" }
        return el
    end
    local function slider(tab, name, key, min, max, inc, suffix, cb)
        local el = tab:CreateSlider({
            Name = name, Range = { min, max }, Increment = inc, Suffix = suffix or "",
            CurrentValue = C[key], Flag = "vh_" .. key,
            Callback = function(v)
                C[key] = v
                if cb then cb(v) end
            end,
        })
        UI[key] = { el = el, kind = "slider" }
        return el
    end
    local function color(tab, name, key, cb)
        local el = tab:CreateColorPicker({
            Name = name, Color = C[key], Flag = "vh_" .. key,
            Callback = function(v)
                C[key] = v
                if cb then cb(v) end
            end,
        })
        UI[key] = { el = el, kind = "color" }
        return el
    end
    local function textbox(tab, name, key, placeholder, cb)
        local el = tab:CreateInput({
            Name = name, PlaceholderText = placeholder, CurrentValue = C[key], RemoveTextAfterFocusLost = false,
            Flag = "vh_" .. key,
            Callback = function(t)
                C[key] = tostring(t or "")
                if cb then cb(C[key]) end
            end,
        })
        UI[key] = { el = el, kind = "input" }
        return el
    end
    local function dropdown(tab, name, key, options, cb)
        local disp, rev = {}, {}
        for i, o in ipairs(options) do
            local d = T(o)
            disp[i] = d
            rev[d] = o
