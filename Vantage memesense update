--------------------------------------------------------------------------
-- Camera: terceira pessoa (offset aplicado no fim do frame e desfeito no
-- inicio do proximo, para o resto do jogo e o aimbot verem a camera original)
--------------------------------------------------------------------------
local TP = { applied = false, orig = nil, saved = {}, armSaved = {}, parts = {}, arms = {}, char = nil, stamp = 0, fov = nil }
local BODY_NAMES = {
    Head = true, UpperTorso = true, LowerTorso = true,
    LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
    RightUpperArm = true, RightLowerArm = true, RightHand = true,
    LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true,
    RightUpperLeg = true, RightLowerLeg = true, RightFoot = true,
}

local function tpRestoreVis()
    for p, v in pairs(TP.saved) do pcall(function() p.Transparency = v end) end
    for p, v in pairs(TP.armSaved) do pcall(function() p.Transparency = v end) end
    TP.saved, TP.armSaved = {}, {}
end

local function tpRestoreCam()
    if TP.applied then
        local c = cam()
        if c and TP.orig then c.CFrame = TP.orig end
        TP.applied = false
    end
end

local function tpRefreshLists(c, char)
    TP.parts, TP.arms = {}, {}
    if char then
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then
                local body = BODY_NAMES[d.Name] and d.Parent == char
                local acc = d.Name == "Handle" and d.Parent:IsA("Accessory")
                if body or acc then TP.parts[#TP.parts + 1] = d end
            end
        end
    end
    if c then
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("BasePart") then TP.arms[#TP.arms + 1] = d end
        end
    end
end

local function tpApply()
    local c = cam()
    if not c then return end
    if C.FovOn then
        if not TP.fov then TP.fov = c.FieldOfView end
        c.FieldOfView = C.FovVal
    elseif TP.fov then
        c.FieldOfView = TP.fov
        TP.fov = nil
    end

    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local active = C.TpOn and hum and hum.Health > 0
    if TP.char ~= char then
        TP.saved, TP.armSaved, TP.char, TP.stamp = {}, {}, char, 0
    end
    if not active then
        if next(TP.saved) or next(TP.armSaved) then tpRestoreVis() end
        return
    end

    local now = os.clock()
    if now - TP.stamp > 0.6 then
        TP.stamp = now
        tpRefreshLists(c, char)
    end

    -- corpo visivel / bracos da primeira pessoa escondidos
    if C.TpBody then
        for _, p in ipairs(TP.parts) do
            if p.Parent then
                p.LocalTransparencyModifier = 0
                if p.Transparency > 0.01 then
                    if TP.saved[p] == nil then TP.saved[p] = p.Transparency end
                    p.Transparency = 0
                end
            end
        end
    elseif next(TP.saved) then
        for p, v in pairs(TP.saved) do pcall(function() p.Transparency = v end) end
        TP.saved = {}
    end
    if C.TpHideArms then
        for _, p in ipairs(TP.arms) do
            if p.Parent and p.Transparency < 1 then
                if TP.armSaved[p] == nil then TP.armSaved[p] = p.Transparency end
                p.Transparency = 1
            end
        end
    elseif next(TP.armSaved) then
        for p, v in pairs(TP.armSaved) do pcall(function() p.Transparency = v end) end
        TP.armSaved = {}
    end

    -- offset da camera (com colisao)
    local base = c.CFrame
    local want = base * CFrame.new(C.TpX, C.TpY, C.TpDist)
    local pos = want.Position
    if C.TpCollide then
        rayParams.FilterDescendantsInstances = rebuildIgnore(false)
        local res = workspace:Raycast(base.Position, pos - base.Position, rayParams)
        if res then pos = res.Position + res.Normal * 0.3 end
    end
    TP.orig = base
    c.CFrame = CFrame.new(pos) * (base - base.Position)
    TP.applied = true
end

--------------------------------------------------------------------------
-- Corpo: Spin Bot e Anti-Aim (so giram o HumanoidRootPart do seu personagem;
-- a camera nao e tocada, entao a visao normal e a 3a pessoa seguem iguais)
--------------------------------------------------------------------------
local BD = {
    last = os.clock(), hum = nil, autoRot = nil, fixedYaw = nil,
    spin = 0, spinSign = 1, spinT = 0, flip = 1, flipT = 0,
    rnd = 0, rndT = 0, pRnd = 0, pT = 0, tilt = 0, roll = 0, state = "desligado",
}

local function bodyRestore()
    if BD.hum and BD.autoRot ~= nil then
        pcall(function() BD.hum.AutoRotate = BD.autoRot end)
    end
    BD.hum, BD.autoRot, BD.fixedYaw = nil, nil, nil
    BD.tilt, BD.roll = 0, 0
    BD.state = (C.SpinOn or C.AaOn) and "pausado" or "desligado"
end

local function bodyApply()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local c = cam()
    if not ((C.SpinOn or C.AaOn) and hum and root and c and hum.Health > 0 and aliveOf(LP)) then
        if BD.autoRot ~= nil then bodyRestore() end
        BD.state = "desligado"
        BD.last = os.clock()
        return
    end

    local now = os.clock()
    local dt = math.min(now - BD.last, 0.1)
    BD.last = now
    local moving = hum.MoveDirection.Magnitude > 0.1
    local function whenOk(w)
        return w == "Sempre" or (w == "Somente parado" and not moving) or (w == "Somente movendo" and moving)
    end
    local shooting = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
    local look = c.CFrame.LookVector
    local camYaw = math.atan2(-look.X, -look.Z)

    local doSpin = C.SpinOn and whenOk(C.SpinWhen) and not (C.SpinPauseShoot and shooting)
    local doAA = C.AaOn and whenOk(C.AaWhen) and not (C.AaPauseShoot and shooting)
    if not doSpin and not doAA then
        if BD.autoRot ~= nil then bodyRestore() end
        BD.state = "pausado"
        return
    end

    local yaw, pitch, roll = camYaw, 0, 0

    if doAA then
        local base
        if C.AaBase == "Atras" then base = math.pi
        elseif C.AaBase == "Esquerda" then base = math.pi / 2
        elseif C.AaBase == "Direita" then base = -math.pi / 2
        elseif C.AaBase == "Frente" then base = 0
        else base = math.rad(C.AaYaw) end

        local rate = math.max(C.AaRate, 0.5)
        local off = 0
        BD.flipT = BD.flipT + dt
        if BD.flipT >= 1 / rate then BD.flipT = 0 BD.flip = -BD.flip end
        BD.rndT = BD.rndT + dt
        local rndNew = false
        if BD.rndT >= 1 / rate then BD.rndT = 0 rndNew = true end

        if C.AaMode == "Jitter" then
            off = math.rad(C.AaRange) * BD.flip
        elseif C.AaMode == "Oscilar" then
            off = math.rad(C.AaRange) * math.sin(now * math.pi * 2 * C.AaSweep)
        elseif C.AaMode == "Aleatorio" then
            if rndNew then BD.rnd = (math.random() * 2 - 1) * math.rad(C.AaRange) end
            off = BD.rnd
        end

        local ref
        if C.AaFollowCam then
            ref = camYaw
        else
            if not BD.fixedYaw then
                local rl = root.CFrame.LookVector
                BD.fixedYaw = math.atan2(-rl.X, -rl.Z)
            end
            ref = BD.fixedYaw
        end
        yaw = ref + base + off

        local amt = math.rad(C.AaPitchAmt)
        if C.AaPitch == "Cima" then pitch = amt
        elseif C.AaPitch == "Baixo" then pitch = -amt
        elseif C.AaPitch == "Jitter" then pitch = amt * BD.flip
        elseif C.AaPitch == "Aleatorio" then
            if rndNew then BD.pRnd = (math.random() * 2 - 1) * amt end
            pitch = BD.pRnd
        end
        roll = math.rad(C.AaRoll)
    end

    if doSpin then
        local sign = (C.SpinDir == "Anti-horario") and 1 or -1  -- yaw positivo = anti-horario (visto de cima)
        if C.SpinDir == "Alternando" then
            BD.spinT = BD.spinT + dt
            if BD.spinT >= C.SpinFlip then BD.spinT = 0 BD.spinSign = -BD.spinSign end
            sign = BD.spinSign
        end
        local sp = C.SpinSpeed * (1 + (math.random() * 2 - 1) * C.SpinVar / 100)
        BD.spin = (BD.spin + sign * math.rad(sp) * dt) % (math.pi * 2)
        yaw = (doAA and yaw or 0) + BD.spin
        BD.tilt = (BD.tilt + math.rad(C.SpinPitchSpeed) * dt) % (math.pi * 2)
        BD.roll = (BD.roll + math.rad(C.SpinRollSpeed) * dt) % (math.pi * 2)
        pitch = pitch + BD.tilt
        roll = roll + BD.roll
    end

    if BD.autoRot == nil then
        BD.hum = hum
        BD.autoRot = hum.AutoRotate
    end
    hum.AutoRotate = false
    root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, roll)
    BD.state = doSpin and (doAA and "spin + anti-aim" or "spin") or "anti-aim"
end

