local ShootRemote
local function findShoot()
    if ShootRemote and ShootRemote.Parent then return ShootRemote end
    local r
    local ev = ReplicatedStorage:FindFirstChild("Events")
    local x = ev and ev:FindFirstChild("Shoot")
    if x and x:IsA("RemoteEvent") then r = x end
