-- Movimento: velocidade (ReplicatedStorage.Speed)
--------------------------------------------------------------------------
local MV = { speedSaved = {}, stamp = 0, state = "desligado" }

local function origSpeedOf(weapon)
    local f = ReplicatedStorage:FindFirstChild("Speed")
    local w = f and f:FindFirstChild(tostring(weapon))
    local v = w and w:FindFirstChild("WalkSpeed")
    local sv = v and MV.speedSaved[v]
    if sv then return sv * 0.0694 end
    return nil
end

local function speedApply()
    local f = ReplicatedStorage:FindFirstChild("Speed")
    if not f then return end
    local ch = LP.Character
    local crouched = (C.CrSpeedOn and ch and ch:FindFirstChild("Crouched")) and true or false
    for _, w in ipairs(f:GetChildren()) do
        local wv, sc = w:FindFirstChild("WalkSpeed"), w:FindFirstChild("Scoped")
        for _, v in ipairs({ wv, sc }) do
            if v and (v:IsA("NumberValue") or v:IsA("IntValue")) and MV.speedSaved[v] == nil then
                MV.speedSaved[v] = v.Value
            end
        end
        if wv and MV.speedSaved[wv] then
            local ow = MV.speedSaved[wv]
            local target = crouched and C.CrSpeedVal or (C.SpeedOn and C.SpeedVal or nil)
            local want = target and (target / 0.0694) or ow
            if wv.Value ~= want then wv.Value = want end
            if sc and MV.speedSaved[sc] then
                local osc = MV.speedSaved[sc]
                local ratio = (ow > 0) and (osc / ow) or 1
                local wantS = target and (target / 0.0694 * ratio) or osc
                if sc.Value ~= wantS then sc.Value = wantS end
            end
        end
    end
end

local function mvApply()
    pcall(speedApply)
    MV.state = (C.SpeedOn or C.CrSpeedOn) and "ativo" or "desligado"
end

local function modsRefresh()
    pcall(mvApply)
    pcall(NX.gcApply)
    if (C.NoRecoil or C.NoSpread or C.FireRateOn) and not GCM.installed then pcall(installGunConfig) end
    pcall(repatchAll)
end

local function restoreMods()
    C.SpeedOn, C.CrSpeedOn = false, false
    pcall(mvApply)
end

conn(RunService.Heartbeat, function()
    local now = os.clock()
    if now - MV.stamp > 0.5 then
        MV.stamp = now
        if C.SpeedOn or C.CrSpeedOn then pcall(mvApply) end
    end
end)

