local equipCache = {}

local function isBotEnt(p) return type(p) == "table" end

local BOTS = {}   -- [Model] = entidade (bots do jogo: Workspace.DeathmatchBots)

local function teamOf(p)
    if isBotEnt(p) then return p.Model:GetAttribute("Team") end
    return childVal(p:FindFirstChild("Status"), "TeamValue")
end
local function aliveOf(p)
    if isBotEnt(p) then return true end
    local v = childVal(p:FindFirstChild("Status"), "Alive")
    if v == nil then return true end
    return v
end

local function isEnemy(p)
    local a, b = teamOf(LP), teamOf(p)
    if a == nil or b == nil or a == "" or b == "" then return true end
    return tostring(a):lower() ~= tostring(b):lower()
end

local function weaponOf(p)
    if isBotEnt(p) then
        local w = p.Model:GetAttribute("Weapon") or p.Model:GetAttribute("Equipped")
        if type(w) == "string" and w ~= "" then return w end
        return "?"
    end
    local slot = childVal(p:FindFirstChild("Status"), "Equipped")
    local fromSlot
    if type(slot) == "string" and slot ~= "" then
        local v = childVal(p, slot)
        if type(v) == "string" and v ~= "" then fromSlot = v end
    end
    return fromSlot or equipCache[p] or (type(slot) == "string" and slot ~= "" and slot) or "?"
end

local function loadoutOf(p)
    if isBotEnt(p) then return weaponOf(p) end
    local out = {}
    for _, s in ipairs({ "Primary", "Secondary", "Knife" }) do
        local v = childVal(p, s)
        if type(v) == "string" and v ~= "" then out[#out + 1] = v end
    end
    if #out == 0 then return "?" end
    return table.concat(out, " | ")
end

local function shieldOf(p, char)
    if isBotEnt(p) then
        local a = p.Model:GetAttribute("Armor")
        return type(a) == "number" and a or 0
    end
    local v = childVal(p, "Armor")
    if type(v) ~= "number" then v = childVal(char, "Armor") end
    if type(v) ~= "number" then v = 0 end
    return v
end

local function agentOf(p)
    if isBotEnt(p) then
        local a = p.Model:GetAttribute("Agent")
        return type(a) == "string" and a or ""
    end
    local v = childVal(p, "Agent")
    if type(v) ~= "string" or v == "" then v = childVal(p:FindFirstChild("Status"), "Agent") end
    if type(v) ~= "string" or v == "" then v = p:GetAttribute("Agent") end
    if type(v) == "string" then return v end
    return ""
end

-- Retorna char, root, hum se o jogador/bot estiver vivo e valido
local function liveParts(p)
    local char = p.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 then return nil end
    if not aliveOf(p) then return nil end
    return char, root, hum
end

-- lista de alvos possiveis: jogadores (menos voce) e/ou bots
local function entities()
    local out = {}
    if C.IncludePlayers then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then out[#out + 1] = p end
        end
    end
    if C.IncludeBots then
        for _, e in pairs(BOTS) do out[#out + 1] = e end
    end
    return out
end
local function entAllowed(p)
    if isBotEnt(p) then return C.IncludeBots end
    return C.IncludePlayers
end

--------------------------------------------------------------------------
-- Visibilidade (wall check)
--------------------------------------------------------------------------
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true
local ignoreCache = { [false] = { t = 0, list = {} }, [true] = { t = 0, list = {} } }

local function rebuildIgnore(withSmoke)
    local list = {}
    if LP.Character then list[#list + 1] = LP.Character end
    local c = cam()
    if c then list[#list + 1] = c end
    local geo = workspace:FindFirstChild("Geometry")
    if geo then
        for _, n in ipairs({ "Debris", "Ray_Ignore", "DroppedItems", "Projectiles" }) do
            local f = geo:FindFirstChild(n)
            if f then list[#list + 1] = f end
        end
    end
    if withSmoke then
        for _, t in ipairs(CollectionService:GetTagged("VisionSmoke")) do list[#list + 1] = t end
    end
    return list
end

local function isVisible(origin, part, char, withSmoke)
    local now = os.clock()
    local entry = ignoreCache[withSmoke and true or false]
    if now - entry.t > 0.5 then
        entry.list = rebuildIgnore(withSmoke)
        entry.t = now
    end
    local ign = {}
    for i = 1, #entry.list do ign[i] = entry.list[i] end
    local dir = part.Position - origin
    local mag = dir.Magnitude
    if mag < 0.1 then return true end
    dir = dir.Unit * (mag + 1)
    for _ = 1, 6 do
        rayParams.FilterDescendantsInstances = ign
        local res = workspace:Raycast(origin, dir, rayParams)
        if not res then return true end
        local inst = res.Instance
        if inst:IsDescendantOf(char) then return true end
        local m = inst:FindFirstAncestorOfClass("Model")
        if m and m ~= workspace and m:FindFirstChildOfClass("Humanoid") then
            ign[#ign + 1] = m
        elseif inst.Transparency >= 0.99 and not inst.CanCollide then
            ign[#ign + 1] = inst
        else
            return false
        end
    end
    return false
end

--------------------------------------------------------------------------
-- Selecao de alvo (compartilhada por Aimbot)
--------------------------------------------------------------------------
local function fovPx(deg)
    local c = cam()
    if not c then return 0 end
    if deg >= 175 then return 100000 end
    local vf = math.rad(c.FieldOfView)
    return math.tan(math.rad(deg) / 2) / math.tan(vf / 2) * (viewport().Y / 2)
end

local function aimOrigin(mode)
    if mode == "Mouse" then return UserInputService:GetMouseLocation() end
    return viewport() / 2
end

local function candidateParts(char, which, hitbox)
    local list = {}
    local function add(names)
        for _, n in ipairs(names) do
            local x = char:FindFirstChild(n)
            if x and x:IsA("BasePart") then list[#list + 1] = x return end
        end
    end
    local headN = hitbox and { "HeadHB", "Head" } or { "Head" }
    local bodyN = hitbox and { "HumanoidRootPart", "UpperTorso", "Torso" } or { "UpperTorso", "Torso", "HumanoidRootPart" }
    if which == "Head" then
        add(headN)
    elseif which == "Torso" then
        add(bodyN)
    else
        add(headN)
        add(bodyN)
    end
    return list
end

