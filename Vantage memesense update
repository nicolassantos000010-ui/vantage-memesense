-- Auto agachar: o jogo agacha enquanto a tecla esta segurada (Crouch = LeftControl por padrao),
-- entao seguramos/soltamos a tecla virtual conforme o modo.
--------------------------------------------------------------------------
local AC = { held = false, last = 0, state = "desligado", flip = false, flipT = 0 }
local AC_KEYS = {
    LeftControl = { Enum.KeyCode.LeftControl, 0xA2 }, C = { Enum.KeyCode.C, 0x43 }, X = { Enum.KeyCode.X, 0x58 },
    LeftAlt = { Enum.KeyCode.LeftAlt, 0xA4 }, LeftShift = { Enum.KeyCode.LeftShift, 0xA0 },
}
local function setCrouchKey(down)
    local k = AC_KEYS[C.AcKey] or AC_KEYS.LeftControl
    local v = getVIM()
    if v then
        local ok = pcall(function() v:SendKeyEvent(down, k[1], false, game) end)
        if ok then return true end
    end
    if down and keypress then pcall(keypress, k[2]) return true end
    if (not down) and keyrelease then pcall(keyrelease, k[2]) return true end
    return false
end
local function acStep()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local want = C.AcOn
    if want and (not hum or hum.Health <= 0 or not aliveOf(LP)) then want = false end
    if want and (UserInputService:GetFocusedTextBox() or GuiService.MenuIsOpen) then want = false end
    local now = os.clock()
    if want then
        local m = C.AcMode
        if m == "Agachar ao atirar" then
            want = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                or (C.AsOn and AS.cur ~= nil and AS.state == "atirando")
        elseif m == "Agachar parado" then
            want = hum.MoveDirection.Magnitude < 0.1
        elseif m == "Com anti-aim" then
            want = (C.AaOn or C.SpinOn) and BD.state ~= "desligado" and BD.state ~= "pausado"
        elseif m == "Spam (alternar)" then
            local iv = math.max(C.AcInterval, 250) / 1000
            if now - AC.flipT >= iv then AC.flipT = now AC.flip = not AC.flip end
            want = AC.flip
        end
    end
    if want ~= AC.held and now - AC.last >= 0.1 then
        if setCrouchKey(want) then AC.held = want AC.last = now end
    end
    AC.state = want and "agachando" or (C.AcOn and "aguardando" or "desligado")
end

local function restoreMovement()
    C.TpOn, C.SpinOn, C.AaOn, C.AutoJump, C.FovOn, C.AcOn = false, false, false, false, false, false
    pcall(acStep)
    pcall(function() if AJ.held then setSpace(false) AJ.held = false end end)
    pcall(bodyRestore)
    pcall(tpRestoreCam)
    pcall(tpApply)       -- restaura FOV/transparencias
    pcall(tpRestoreVis)
end

RunService:BindToRenderStep("VH_CamRestore", Enum.RenderPriority.First.Value, tpRestoreCam)
RunService:BindToRenderStep("VH_CamApply", Enum.RenderPriority.Last.Value, function()
    pcall(tpApply)
    pcall(bodyApply)
end)
conn(RunService.Heartbeat, function()
    pcall(ajStep)
    pcall(bodyApply)
    pcall(acStep)
end)

