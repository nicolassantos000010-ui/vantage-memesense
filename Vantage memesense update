-- Verificacao de requisitos ao ativar funcoes (guard)
--  - cada funcao tem uma checagem do que precisa (funcoes do executor, remotes, modulos)
--  - se faltar algo e nao houver fallback, avisa o que precisa e desativa a funcao sozinha
--  - se houver fallback (outro metodo), troca e avisa; erro na propria checagem NAO desativa nada
--------------------------------------------------------------------------
local function setCfg(k, val)
    if C[k] == nil then return end
    C[k] = val
    local u = UI[k]
    if u then
        pcall(function()
            if u.kind == "dropdown" then u.el:Set({ T(val) }) else u.el:Set(val) end
        end)
    end
    C[k] = val
end

