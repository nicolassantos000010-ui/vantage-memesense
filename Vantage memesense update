    for _, k in ipairs({ "hl", "box", "tracer", "topText", "botText" }) do
        pcall(function() o[k]:Destroy() end)
    end
    ESP[p] = nil
end

local function updateESP(o, now)
    local p = o.p
    local char, root, hum = liveParts(p)
    local c = cam()
    if not char or not c or not entAllowed(p) then hideESP(o) return end

    local enemy = isEnemy(p)
    local wantChams = C.ChamsOn and (enemy or C.ChamsAllies)
    local wantEsp = C.EspOn and (enemy or C.EspAllies)
    if not wantChams and not wantEsp then hideESP(o) return end

    local camPos = c.CFrame.Position
    local dist = (root.Position - camPos).Magnitude / STUDS_PER_METER

    if o.char ~= char then
        o.char = char
        o.hl.Adornee = char
        o.box.Adornee = root
    end

    -- visibilidade (15 Hz)
    local needVis = (wantChams and C.ChamsByVis) or (wantEsp and C.EspVisColor)
    if needVis and now - o.visStamp > 0.07 then
        o.visStamp = now
        local head = char:FindFirstChild("Head") or root
        o.vis = isVisible(camPos, head, char, false)
    end

    -- Chams
    if wantChams and dist <= C.ChamsMaxDist then
        local fill = enemy and C.ChamsFill or C.ChamsAllyColor
        if C.ChamsByVis then fill = o.vis and C.ChamsVisColor or C.ChamsHidColor end
        o.hl.FillColor = fill
        o.hl.OutlineColor = C.ChamsOutline
        o.hl.FillTransparency = C.ChamsFillT
        o.hl.OutlineTransparency = C.ChamsOutT
        o.hl.DepthMode = C.ChamsWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
        o.hl.Enabled = true
    else
        o.hl.Enabled = false
    end

    -- ESP
    if wantEsp and dist <= C.EspMaxDist then
        local col = enemy and C.EspBoxColor or C.EspAllyColor
        if C.EspVisColor and o.vis then col = C.EspVisColorVis end

        o.box.Enabled = true
        o.boxStroke.Enabled = C.EspBox
        o.boxStroke.Color = col
        o.boxStroke.Thickness = C.EspBoxThick
        local hpFrac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
        o.hpBg.Visible = C.EspHealthBar
        o.hpFill.Size = UDim2.new(1, 0, hpFrac, 0)
        o.hpFill.BackgroundColor3 = Color3.fromHSV(hpFrac * 0.33, 1, 1)
        local shield = shieldOf(p, char)
        o.shBg.Visible = C.EspShieldBar and shield > 0
        o.shFill.Size = UDim2.new(1, 0, math.clamp(shield / math.max(C.ShieldMax, 1), 0, 1), 0)

        if now - o.textStamp > 0.1 then
            o.textStamp = now
            local okT, errT = pcall(function()
            local top, bot = {}, {}
            if C.EspName then
                local s = tostring((p.DisplayName ~= nil and p.DisplayName ~= "") and p.DisplayName or p.Name or "?")
                top[#top + 1] = string.format('<font color="%s">%s</font>', hex(col), s)
            end
            if C.EspAgent then
                local a = agentOf(p)
                if a ~= "" then top[#top + 1] = "[" .. a .. "]" end
            end
            if C.EspSpike then
                local hs
                if isBotEnt(p) then hs = p.Model:GetAttribute("HasSpike")
                else hs = p:GetAttribute("HasSpike") or childVal(p, "HasSpike") end
                if hs == true then top[#top + 1] = '<font color="#ffd23c">[SPIKE]</font>' end
            end
            if C.EspWeapon then
                local w = weaponOf(p)
                if not (isBotEnt(p) and w == "?") then bot[#bot + 1] = w end
            end
            if C.EspLoadout then
                local w = loadoutOf(p)
                if not (isBotEnt(p) and w == "?") then bot[#bot + 1] = w end
            end
            if C.EspShield then
                if shield > 0 then
                    bot[#bot + 1] = string.format('<font color="#59a6ff">Escudo: sim (%d)</font>', shield)
                else
                    bot[#bot + 1] = '<font color="#aaaaaa">Escudo: nao</font>'
                end
            end
            local line = {}
            if C.EspHealthText then line[#line + 1] = string.format("HP %d", math.floor(hum.Health + 0.5)) end
            if C.EspDist then line[#line + 1] = string.format("%dm", math.floor(dist + 0.5)) end
            if #line > 0 then bot[#bot + 1] = table.concat(line, "  ") end
            o.topText.Text = table.concat(top, " ")
            o.botText.Text = table.concat(bot, "\n")
            o.topText.TextSize = C.EspTextSize
            o.botText.TextSize = C.EspTextSize
            o.topText.TextColor3 = C.EspTextColor
            o.botText.TextColor3 = C.EspTextColor
            end)
            ESPERR = okT and nil or tostring(errT)
        end
        -- posicao na tela (labels ficam no Overlay, nao no billboard)
        local rp = root.Position
        local tp = c:WorldToViewportPoint(rp + Vector3.new(0, 3.4, 0))
        local bp = c:WorldToViewportPoint(rp - Vector3.new(0, 3.4, 0))
        local onScreen = tp.Z > 0 and bp.Z > 0
        o.topText.Position = UDim2.fromOffset(tp.X, tp.Y - 2)
        o.botText.Position = UDim2.fromOffset(bp.X, bp.Y + 2)
        o.topText.Visible = onScreen and (C.EspName or C.EspAgent or C.EspSpike) and o.topText.Text ~= ""
        o.botText.Visible = onScreen and (C.EspWeapon or C.EspLoadout or C.EspShield or C.EspHealthText or C.EspDist) and o.botText.Text ~= ""

        -- tracer
        if C.EspTracer then
            local sp = c:WorldToViewportPoint(root.Position)
            if sp.Z > 0 then
                local vp = viewport()
                local from
                if C.EspTracerFrom == "Centro" then from = vp / 2
                elseif C.EspTracerFrom == "Cima" then from = Vector2.new(vp.X / 2, 0)
                else from = Vector2.new(vp.X / 2, vp.Y) end
                local to = Vector2.new(sp.X, sp.Y)
                local d = to - from
                o.tracer.Size = UDim2.fromOffset(d.Magnitude, C.EspTracerThick)
                o.tracer.Position = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2)
                o.tracer.Rotation = math.deg(math.atan2(d.Y, d.X))
                o.tracer.BackgroundColor3 = C.EspTracerColor
                o.tracer.Visible = true
            else
                o.tracer.Visible = false
            end
        else
            o.tracer.Visible = false
        end
    else
        o.box.Enabled = false
        o.tracer.Visible = false
        o.topText.Visible = false
        o.botText.Visible = false
    end
end

