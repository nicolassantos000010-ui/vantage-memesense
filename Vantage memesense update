local function notifyT(o)
    o.Title = T(o.Title)
    o.Content = T(o.Content)
    return Rayfield:Notify(o)
end

local function wrapTab(tab)
    local w = {}
    function w:CreateSection(n) return tab:CreateSection(T(n)) end
    function w:CreateLabel(t) return tab:CreateLabel(T(t)) end
    function w:CreateButton(o) o.Name = T(o.Name) return tab:CreateButton(o) end
    function w:CreateToggle(o) o.Name = T(o.Name) return tab:CreateToggle(o) end
    function w:CreateSlider(o)
        o.Name = T(o.Name)
        if o.Suffix then o.Suffix = T(o.Suffix) end
        return tab:CreateSlider(o)
    end
    function w:CreateColorPicker(o) o.Name = T(o.Name) return tab:CreateColorPicker(o) end
    function w:CreateInput(o)
        o.Name = T(o.Name)
        if o.PlaceholderText then o.PlaceholderText = T(o.PlaceholderText) end
        return tab:CreateInput(o)
    end
    function w:CreateKeybind(o) o.Name = T(o.Name) return tab:CreateKeybind(o) end
    function w:CreateDropdown(o) o.Name = T(o.Name) return tab:CreateDropdown(o) end
    return w
end

local HttpService = game:GetService("HttpService")
local CFG_DIR = "VantageMemesense"
local CFG = { name = "padrao", list = {}, sel = nil }
local fsOk = writefile and readfile and isfile and makefolder and isfolder and listfiles and true or false

local function saveLang()
    if fsOk then
        pcall(function()
            if not isfolder(CFG_DIR) then makefolder(CFG_DIR) end
            writefile(CFG_DIR .. "/_lang.txt", C.Lang)
        end)
    end
end
local function loadLang()
    if fsOk and isfile(CFG_DIR .. "/_lang.txt") then
        local ok, v = pcall(readfile, CFG_DIR .. "/_lang.txt")
        if ok and (v == "Portugues" or v == "English") then C.Lang = v end
    end
end

local function cfgPath(n)
    return CFG_DIR .. "/" .. tostring(n):gsub("[^%w_%-]", "_") .. ".json"
end
local function cfgEnsure()
    if not fsOk then return false end
    if not isfolder(CFG_DIR) then pcall(makefolder, CFG_DIR) end
    return isfolder(CFG_DIR)
end
local guardAll   -- definido mais abaixo (verificacao de requisitos)
local function cfgEncode()
    local t = {}
    for k, v in pairs(C) do
        if k ~= "Dead" then
            local tv = typeof(v)
            if tv == "Color3" then t[k] = { __c = { v.R, v.G, v.B } }
            elseif tv == "number" or tv == "boolean" or tv == "string" then t[k] = v end
        end
    end
    return HttpService:JSONEncode(t)
end
local function cfgApply(json)
    local ok, t = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or type(t) ~= "table" then return false, "arquivo invalido" end
    local n = 0
    local langChanged = false
    for k, v in pairs(t) do
        local cur = C[k]
        if k == "Lang" then
            if (v == "Portugues" or v == "English") and v ~= C.Lang then
                C.Lang = v
                langChanged = true
            end
        elseif cur ~= nil and k ~= "Dead" then
            local val
            if typeof(cur) == "Color3" and type(v) == "table" and type(v.__c) == "table" then
                val = Color3.new(v.__c[1], v.__c[2], v.__c[3])
            elseif type(v) == type(cur) then
                val = v
            end
            if val ~= nil then
                C[k] = val
                local u = UI[k]
                if u then
                    pcall(function()
                        if u.kind == "dropdown" then u.el:Set({ T(val) }) else u.el:Set(val) end
                    end)
                end
                C[k] = val
                n = n + 1
            end
        end
    end
    refreshAimOpts()
    pcall(modsRefresh)
    post(guardAll)
    if langChanged then
        saveLang()
        task.defer(function() rebuildMenu() end)
    end
    return true, n
end
local function cfgList()
    local out = {}
    if cfgEnsure() then
        local ok, files = pcall(listfiles, CFG_DIR)
        if ok and type(files) == "table" then
            for _, f in ipairs(files) do
                local n = tostring(f):match("([^/\\]+)%.json$")
                if n then out[#out + 1] = n end
            end
        end
    end
    table.sort(out)
    return out
end

