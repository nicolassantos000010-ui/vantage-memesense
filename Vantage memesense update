local GCraw
local function gunCfg()
    if GCraw == nil then
        GCraw = false
        local m = ReplicatedStorage:FindFirstChild("Modules")
        m = m and m:FindFirstChild("GunConfig")
        if m then
            local ok, r = pcall(require, m)
            if ok and type(r) == "table" then GCraw = r end
        end
    end
    if not GCraw then return nil end
    local ok, cfg = pcall(GCraw.Get, weaponOf(LP))
    if ok and type(cfg) == "table" then return cfg end
    return nil
end

-- o = {fov, all(360), part, hitbox, team(bool = so inimigos), wall, maxDist, sort, origin, smokeIgnore}
local function pickTarget(o, onlyPlayer)
    local c = cam()
    if not c then return nil end
    local origin2d = aimOrigin(o.origin)
    local radius = fovPx(o.fov)
    local camPos = c.CFrame.Position
    local best, bestScore
    for _, p in ipairs(entities()) do
        if (not onlyPlayer or p == onlyPlayer) then
            local char, root, hum = liveParts(p)
            if char and ((not o.team) or isEnemy(p)) then
                local dist = (root.Position - camPos).Magnitude / STUDS_PER_METER
                if dist <= o.maxDist then
                    local cands = candidateParts(char, o.part, o.hitbox)
                    for _, part in ipairs(cands) do
                        local sp, on = c:WorldToViewportPoint(part.Position)
                        if sp.Z > 0 or o.all then
                            local d2 = (Vector2.new(sp.X, sp.Y) - origin2d).Magnitude
                            if sp.Z <= 0 then d2 = 0 end
                            if d2 <= radius or onlyPlayer or o.all then
                                local ok = true
                                if o.wall then ok = isVisible(camPos, part, char, o.smokeIgnore) end
                                if ok then
                                    local score = d2
                                    if o.sort == "Distancia" then score = dist
                                    elseif o.sort == "Vida" then score = hum.Health end
                                    if not bestScore or score < bestScore then
                                        bestScore = score
                                        best = { player = p, part = part, screen = Vector2.new(sp.X, sp.Y), list = cands, char = char, hum = hum }
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

