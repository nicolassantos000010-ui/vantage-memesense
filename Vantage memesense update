-- Arma: no recoil / no spread (GunConfig, modulo usado pelo cliente)
--------------------------------------------------------------------------
local GCM = { mod = nil, orig = nil, cfgs = {}, saved = {}, installed = false }
local REC_FIELDS = { "Kick", "KickBack", "Roll", "CamShare", "YawShare" }
local SPR_FIELDS = { "Base", "AdsBase", "Walk", "Run", "Jump", "Land", "BloomPerShot", "MaxBloom" }
local PAT_FIELDS = { "Climb", "Bias", "Jitter", "SwayAmp" }
local RATE_FIELDS = { "Rate", "AdsRate" }

local function patchCfg(c)
    if type(c) ~= "table" then return end
    local s = GCM.saved[c]
    if not s then
        s = { f = {}, p = nil, pt = nil }
        for _, k in ipairs(REC_FIELDS) do s.f[k] = c[k] end
        for _, k in ipairs(SPR_FIELDS) do s.f[k] = c[k] end
        for _, k in ipairs(RATE_FIELDS) do s.f[k] = c[k] end
        if type(c.Burst) == "table" then
            s.burst = c.Burst
            s.bf = { Rate = c.Burst.Rate, Cycle = c.Burst.Cycle }
        end
        if type(c.Pattern) == "table" and not GCM.saved[c.Pattern] then
            s.pt = c.Pattern
            s.p = {}
            for _, k in ipairs(PAT_FIELDS) do s.p[k] = c.Pattern[k] end
            GCM.saved[c.Pattern] = { shared = true }
        end
        GCM.saved[c] = s
        GCM.cfgs[#GCM.cfgs + 1] = c
    end
    for _, k in ipairs(REC_FIELDS) do
        if s.f[k] ~= nil then c[k] = C.NoRecoil and 0 or s.f[k] end
    end
    for _, k in ipairs(SPR_FIELDS) do
        if s.f[k] ~= nil then c[k] = C.NoSpread and 0 or s.f[k] end
    end
    for _, k in ipairs(RATE_FIELDS) do
        if s.f[k] ~= nil then c[k] = C.FireRateOn and s.f[k] * C.FireRateMul or s.f[k] end
    end
    if s.burst and s.bf then
        if s.bf.Rate then s.burst.Rate = C.FireRateOn and s.bf.Rate * C.FireRateMul or s.bf.Rate end
        if s.bf.Cycle then s.burst.Cycle = C.FireRateOn and s.bf.Cycle / C.FireRateMul or s.bf.Cycle end
    end
    if s.pt and s.p then
        for k, v in pairs(s.p) do
            if v ~= nil then s.pt[k] = C.NoRecoil and 0 or v end
        end
    end
end

local function repatchAll()
    for _, c in ipairs(GCM.cfgs) do patchCfg(c) end
end

local function installGunConfig()
    if GCM.installed then return true end
    local mods = ReplicatedStorage:FindFirstChild("Modules")
    local ms = mods and mods:FindFirstChild("GunConfig")
    if not ms then
        for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
            if d.Name == "GunConfig" and d:IsA("ModuleScript") then ms = d break end
        end
    end
    if not ms then return false, "GunConfig nao encontrado" end
    local ok, gc = pcall(require, ms)
    if not ok or type(gc) ~= "table" then return false, "require(GunConfig) falhou" end
    GCM.mod = gc
    GCM.orig = {
        Get = gc.Get, PatternOffset = gc.PatternOffset, Bloom = gc.Bloom,
        MovementError = gc.MovementError, SpringImpulse = gc.SpringImpulse,
    }
    local o = GCM.orig
    gc.Get = function(n)
        local c = o.Get(n)
        if c then patchCfg(c) end
        return c
    end
    gc.PatternOffset = function(cfg, n)
        if C.NoRecoil then return 0, 0 end
        return o.PatternOffset(cfg, n)
    end
    gc.Bloom = function(cfg, n)
        if C.NoSpread then return 0 end
        return o.Bloom(cfg, n)
    end
    gc.MovementError = function(cfg, sp)
        if C.NoSpread then return 0 end
        return o.MovementError(cfg, sp)
    end
    gc.SpringImpulse = function(a, b)
        if C.NoRecoil then return 0 end
        return o.SpringImpulse(a, b)
    end
    -- configs ja criadas (cache do modulo): puxa todas pelo nome das armas
    pcall(function()
        local we = ReplicatedStorage:FindFirstChild("WeaponEngine")
        local wf = we and we:FindFirstChild("Weapons")
        if wf then
            for _, w in ipairs(wf:GetChildren()) do pcall(gc.Get, w.Name) end
        end
    end)
    GCM.installed = true
    return true
end

local function restoreGunConfig()
    if not GCM.installed or not GCM.mod then return end
    C.NoRecoil = false
    C.NoSpread = false
    C.FireRateOn = false
    repatchAll()
    for k, v in pairs(GCM.orig) do pcall(function() GCM.mod[k] = v end) end
    GCM.installed = false
    GCM.cfgs = {}
    GCM.saved = {}
end

