    })
    local function cfgRefresh()
        CFG.list = cfgList()
        local opts = #CFG.list > 0 and CFG.list or { "(nenhum)" }
        pcall(function() cfgDrop:Refresh(opts) end)
    end
    local function note(t, c) notifyT({ Title = "Config", Content = c, Duration = 4 }) end
    tCfg:CreateButton({
        Name = "Salvar perfil (com o nome acima)",
        Callback = function()
            if not cfgEnsure() then note("", "Sem acesso a arquivos neste executor") return end
            local ok, err = pcall(writefile, cfgPath(CFG.name), cfgEncode())
            if ok then note("", T("Salvo: ") .. CFG.name) else note("", T("Falha ao salvar: ") .. tostring(err)) end
            cfgRefresh()
        end,
    })
    tCfg:CreateButton({
        Name = "Carregar perfil selecionado",
        Callback = function()
            local n = CFG.sel or CFG.name
            if not fsOk or not isfile(cfgPath(n)) then note("", T("Perfil nao encontrado: ") .. tostring(n)) return end
            local ok, data = pcall(readfile, cfgPath(n))
            if not ok then note("", "Falha ao ler") return end
            local good, cnt = cfgApply(data)
            note("", good and (T("Carregado: ") .. n .. " (" .. cnt .. T(" opcoes)")) or tostring(cnt))
        end,
    })
    tCfg:CreateButton({
        Name = "Excluir perfil selecionado",
        Callback = function()
            local n = CFG.sel
            if not n or not fsOk or not isfile(cfgPath(n)) then note("", "Selecione um perfil") return end
            if delfile then pcall(delfile, cfgPath(n)) note("", T("Excluido: ") .. n) else note("", "Executor sem delfile") end
            CFG.sel = nil
            cfgRefresh()
        end,
    })
    tCfg:CreateButton({ Name = "Atualizar lista", Callback = cfgRefresh })
    tCfg:CreateSection("Iniciar com perfil")
    tCfg:CreateButton({
        Name = "Carregar o perfil selecionado automaticamente ao executar",
        Callback = function()
            local n = CFG.sel or CFG.name
            if not cfgEnsure() then note("", "Sem acesso a arquivos") return end
            pcall(writefile, CFG_DIR .. "/_autoload.txt", tostring(n))
            note("", T("Auto-carregar: ") .. tostring(n))
        end,
    })
    tCfg:CreateButton({
        Name = "Desligar auto-carregar",
        Callback = function()
            if fsOk and isfile(CFG_DIR .. "/_autoload.txt") and delfile then pcall(delfile, CFG_DIR .. "/_autoload.txt") end
            note("", "Auto-carregar desligado")
        end,
    })
    tCfg:CreateSection("Area de transferencia")
    tCfg:CreateButton({
        Name = "Exportar configuracao atual (copiar JSON)",
        Callback = function()
            if setclipboard then pcall(setclipboard, cfgEncode()) note("", "JSON copiado") else note("", "Executor sem setclipboard") end
        end,
    })
    tCfg:CreateInput({
        Name = "Importar (cole o JSON e tecle Enter)", PlaceholderText = "{...}", RemoveTextAfterFocusLost = true,
        Callback = function(txt)
            if not txt or txt == "" then return end
            local good, cnt = cfgApply(txt)
            note("", good and (T("Importado (") .. cnt .. T(" opcoes)")) or tostring(cnt))
        end,
    })
    cfgRefresh()

    -- ============ Diagnostico ============
    local tDiag = newTab("Diagnostico")
    tDiag:CreateSection("Verificacao dos caminhos do jogo")
    tDiag:CreateButton({
        Name = "Rodar diagnostico (copia o relatorio)",
        Callback = function()
            local L = {}
            local function add(s) L[#L + 1] = s end
            add("Click: mouse1click=" .. tostring(mouse1click ~= nil) .. " mouse1press=" .. tostring(mouse1press ~= nil))
            local gcfg = gunCfg()
            add("Arma atual: " .. tostring(weaponOf(LP)) .. " Rate=" .. tostring(gcfg and gcfg.Rate))
            add("hookfunction=" .. tostring(hookfunction ~= nil) .. " hookmetamethod=" .. tostring(hookmetamethod ~= nil)
                .. " mousemoverel=" .. tostring(mousemoverel ~= nil) .. " gethui=" .. tostring(gethui ~= nil))
            add("Eu: team=" .. tostring(teamOf(LP)) .. " armor=" .. tostring(childVal(LP, "Armor"))
                .. " equipped=" .. tostring(childVal(LP:FindFirstChild("Status"), "Equipped")))
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP then
                    local char = p.Character
                    local names = {}
                    if char then
                        for _, n in ipairs({ "Head", "HeadHB", "HumanoidRootPart", "UpperTorso", "Torso", "Humanoid" }) do
                            names[#names + 1] = n .. "=" .. tostring(char:FindFirstChild(n) ~= nil)
                        end
                    end
                    add(string.format("%s: team=%s alive=%s agent=%s armor=%s weapon=%s loadout=%s char=%s [%s]",
                        p.Name, tostring(teamOf(p)), tostring(aliveOf(p)), agentOf(p),
                        tostring(childVal(p, "Armor")), weaponOf(p), loadoutOf(p), tostring(char ~= nil), table.concat(names, " ")))
                    local st = p:FindFirstChild("Status")
                    if st then
                        local kids = {}
                        for _, k in ipairs(st:GetChildren()) do kids[#kids + 1] = k.Name end
                        add("   Status: " .. table.concat(kids, ", "))
                    end
                    local pk = {}
                    for _, k in ipairs(p:GetChildren()) do pk[#pk + 1] = k.Name end
                    add("   Player filhos: " .. table.concat(pk, ", "))
                end
            end
            for m, e in pairs(BOTS) do
                local at = {}
                for k, v in pairs(m:GetAttributes()) do at[#at + 1] = k .. "=" .. tostring(v) end
                add(string.format("BOT %s: enemy=%s hp=%s attrs[%s]", e.Name, tostring(isEnemy(e)),
                    tostring(m:FindFirstChildOfClass("Humanoid") and m:FindFirstChildOfClass("Humanoid").Health), table.concat(at, ", ")))
            end
            add(("Auto Shoot: remote=%s ammo=%s intervalo=%.3f s | AutoJump=%s | VIM=%s keypress=%s"):format(
                tostring(findShoot() ~= nil), tostring(ammoLeft()), fireInterval(), AJ.state, tostring(getVIM() and true or false), tostring(keypress ~= nil)))
            add(("Extras: recarga=%s auto=%d | cabeca=%s enviados=%d | equip=%s puladas=%d err=%s | nomes rotulos=%d"):format(
                NX.rl.state, NX.rl.auto, NX.hd.state, NX.hd.sent, NX.eq.state, NX.eq.skipped, NX.eq.err ~= "" and NX.eq.err or "-", NX.nm.count))
            add(("Movimento: Speed folder=%s | velocidade=%s | pente=%s"):format(
                tostring(ReplicatedStorage:FindFirstChild("Speed") ~= nil), MV.state, tostring(ammoLeft())))
            add(("Executor: hookmetamethod=%s getnamecallmethod=%s checkcaller=%s newcclosure=%s setnamecallmethod=%s hookfunction=%s mousemoverel=%s mouse1click=%s keypress=%s"):format(
                tostring(hasFn(hookmetamethod)), tostring(hasFn(getnamecallmethod)), tostring(hasFn(checkcaller)),
                tostring(hasFn(newcclosure)), tostring(hasFn(setnamecallmethod)), tostring(hasFn(hookfunction)),
                tostring(hasFn(mousemoverel)), tostring(hasFn(mouse1click)), tostring(hasFn(keypress))))
            local txt = table.concat(L, "\n")
            print("[VH diagnostico]\n" .. txt)
            if setclipboard then pcall(setclipboard, txt) end
            notifyT({ Title = "Diagnostico", Content = T("Relatorio no console (F9)") .. (setclipboard and T(" e na area de transferencia") or ""), Duration = 6 })
        end,
    })
    tDiag:CreateButton({
        Name = "Descarregar script (remove tudo)",
        Callback = function() if env.VH_Unload then env.VH_Unload() end end,
    })


end

