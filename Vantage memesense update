disableFeature = function(key, reason)
    setCfg(key, false)
    if notifyT then
        notifyT({
            Title = "Vantage Memesense",
            Content = T("Nao foi possivel ativar: ") .. T(FEATURE_NAME[key] or key) .. ". " .. tostring(reason)
                .. T(" Funcao desativada automaticamente."),
            Duration = 9,
        })
    end
end

local function guard(key)
    if C.Dead or not C[key] then return end
    local f = REQ[key]
    if not f then return end
    local ok, missing, info = pcall(f)
    if not ok then
        if notifyT then
            notifyT({ Title = "Vantage Memesense",
                Content = T("A verificacao de ") .. T(FEATURE_NAME[key] or key) .. T(" falhou (") .. tostring(missing)
                    .. T("); a funcao foi mantida ligada."), Duration = 7 })
        end
        return
    end
    if type(missing) == "table" and #missing > 0 then
        disableFeature(key, T("Falta: ") .. table.concat(missing, "; ") .. ".")
        return
    end
    if info and notifyT then
        notifyT({ Title = "Vantage Memesense", Content = T(FEATURE_NAME[key] or key) .. ": " .. T(info), Duration = 7 })
    end
end
guardAll = function()
    for key in pairs(REQ) do
        if C[key] then guard(key) end
    end
end

