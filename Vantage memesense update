local function isBotModel(m)
    if not m:IsA("Model") then return false end
    if m:GetAttribute("BotId") == nil and m:GetAttribute("BotName") == nil then return false end
    return m:FindFirstChildOfClass("Humanoid") ~= nil
end
local function scanBots()
    local seen = {}
    local function consider(m)
        if isBotModel(m) then
            seen[m] = true
            if not BOTS[m] then
                local ent = { IsBot = true, Model = m, Character = m, DisplayName = "",
                    Name = tostring(m:GetAttribute("BotName") or m.Name) }
                BOTS[m] = ent
                newESP(ent)
            end
        end
    end
    local folder = workspace:FindFirstChild("DeathmatchBots")
    if folder then
        for _, m in ipairs(folder:GetChildren()) do consider(m) end
    else
        -- nome da pasta pode variar: procura 1 nivel dentro do Workspace
        for _, f in ipairs(workspace:GetChildren()) do
            if f:IsA("Model") then consider(f)
            elseif f:IsA("Folder") then
                for _, m in ipairs(f:GetChildren()) do consider(m) end
            end
        end
    end
    for m, ent in pairs(BOTS) do
        if not seen[m] or not m.Parent then
            destroyESP(ent)
            BOTS[m] = nil
        end
    end
end
