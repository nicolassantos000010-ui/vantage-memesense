local function gunReq()
    local mods = ReplicatedStorage:FindFirstChild("Modules")
    local ms = mods and mods:FindFirstChild("GunConfig")
    if not ms then return { "ReplicatedStorage.Modules.GunConfig" } end
    local ok = pcall(require, ms)
    if not ok then return { "require(GunConfig) (o executor nao conseguiu carregar o modulo)" } end
    return {}
end

local REQ = {}
REQ.ChamsOn = function()
    local ok = pcall(function() local h = Instance.new("Highlight") h:Destroy() end)
    if ok then return {} end
    return { "Instance.new('Highlight')" }
end
REQ.EspOn = function()
    local m = {}
    if not cam() then m[#m + 1] = "Workspace.CurrentCamera" end
    if not Overlay or not Overlay.Parent then m[#m + 1] = "ScreenGui em gethui()/CoreGui" end
    return m
end
REQ.AimOn = function()
    if not cam() then return { "Workspace.CurrentCamera" } end
    if C.AimMethod == "Mouse" and not hasFn(mousemoverel) then
        setCfg("AimMethod", "Camera")
        return {}, "mousemoverel ausente: metodo de mira trocado para Camera"
    end
    return {}
end
REQ.AsOn = function()
    local canClick = hasFn(mouse1click) or (hasFn(mouse1press) and hasFn(mouse1release)) or (getVIM() and true or false)
    local canRemote = findShoot() ~= nil
    if C.AsRemote then
        if not canRemote then
            if canClick then
                setCfg("AsRemote", false)
                return {}, "Events.Shoot nao encontrado: usando clique simulado"
            end
            return { "Events.Shoot (remote)", "mouse1click ou VirtualInputManager" }
        end
    else
        if not canClick then
            if canRemote then
                setCfg("AsRemote", true)
                return {}, "sem funcao de clique: usando o remote Events.Shoot"
            end
            return { "mouse1click (ou mouse1press + mouse1release, ou VirtualInputManager)", "Events.Shoot (remote)" }
        end
    end
    return {}
end
