local hitParams = RaycastParams.new()
hitParams.FilterType = Enum.RaycastFilterType.Include
hitParams.IgnoreWater = true

-- ponto de acerto na superficie da parte (posicao + normal), como o jogo reporta
local function surfaceHit(origin, part)
    local dir = part.Position - origin
    local mag = dir.Magnitude
    if mag < 0.05 then return part.Position, Vector3.new(0, 1, 0) end
    hitParams.FilterDescendantsInstances = { part }
    local ok, res = pcall(function()
        return workspace:Raycast(origin, dir.Unit * (mag + 6), hitParams)
    end)
    if ok and res and res.Instance == part then return res.Position, res.Normal end
    local back = -dir.Unit
    local r = (part.Size.X + part.Size.Y + part.Size.Z) / 6
    return part.Position + back * r, back
end

local function slotNow()
    local v = childVal(LP:FindFirstChild("Status"), "Equipped")
    if v == "Primary" or v == "Secondary" or v == "Knife" then return v end
    return "Primary"
end

local function ammoLeft()
    local inv = LP:FindFirstChild("Inventory")
    local item = inv and inv:FindFirstChild(weaponOf(LP))
    local a = item and childVal(item, "Ammo")
    if type(a) == "number" then return a end
    return nil
end

local function fireInterval()
    local cfg = gunCfg()
    if cfg and type(cfg.Rate) == "number" and cfg.Rate > 0 then return 1 / cfg.Rate end
    return 0.1
end

local function fireRemote(tgt)
    local r = findShoot()
    if not r then return false, "Events.Shoot nao encontrado" end
    local c = cam()
    if not c then return false, "sem camera" end
    local ammo = ammoLeft()
    if ammo and ammo <= 0 then return false, "sem municao" end
    local part = tgt.part
    if not part or not part.Parent then return false, "alvo invalido" end
    local origin = c.CFrame.Position
    local pos, normal = surfaceHit(origin, part)
    local muzzle = origin + c.CFrame.LookVector
    local ts = (C.AsTime == "tick()") and tick() or workspace:GetServerTimeNow()
    local ok, err = pcall(function()
        r:FireServer(part, pos, normal, slotNow(), origin, true, muzzle, ts, nil, false, nil, nil, nil)
    end)
    if not ok then return false, tostring(err) end
    return true
end

local function snapCamera(part)
    local c = cam()
    if not c then return end
    c.CFrame = c.CFrame:Lerp(CFrame.lookAt(c.CFrame.Position, part.Position), smoothK(C.AsAimSmooth))
end

local function angleTo(pos)
    local c = cam()
    if not c then return 180 end
    local d = pos - c.CFrame.Position
    if d.Magnitude < 0.01 then return 0 end
    return math.deg(math.acos(math.clamp(c.CFrame.LookVector:Dot(d.Unit), -1, 1)))
end

local function asOpts()
    local is360 = C.AsMode == "360"
    return {
        fov = is360 and 180 or C.AsFov, all = is360, part = C.AsPart, hitbox = false,
        team = C.AsTeam, wall = (C.AsWall == "So visivel"), maxDist = C.AsMaxDist, sort = C.AsSort,
        origin = C.AsFovOrigin, smokeIgnore = false,
    }
end

local function asStep()
    if not C.AsOn then
        AS.cur, AS.since, AS.state = nil, nil, "desligado"
        return
    end
    local now = os.clock()
    if not aliveOf(LP) then AS.cur, AS.since, AS.state = nil, nil, "voce morto" return end
    if childVal(LP:FindFirstChild("Status"), "Equipped") == "Knife" then
        AS.cur, AS.since, AS.state = nil, nil, "faca equipada"
        return
    end
    local tgt = pickTarget(asOpts())
    AS.cur = tgt
    if not tgt then AS.since, AS.state = nil, "sem alvo" return end

    local part = tgt.part
    local remote = C.AsRemote
    -- no remote o alvo e enviado direto: nao precisa girar a camera
    if C.AsMode == "360" and C.AsAim360 and not remote then
        snapCamera(part)
        if angleTo(part.Position) > C.AsAimTol then AS.state = "mirando" return end
    end
    if not AS.since then AS.since = now end
    if now - AS.since < C.AsReact / 1000 then AS.state = "reacao" return end
    if (not remote) and C.AsNeedLock and UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
        AS.state = "mouse nao travado"
        return
    end
    if now - AS.last < AS.nextDelay then AS.state = "delay" return end

    local ok, err
    if remote then
        ok, err = fireRemote(tgt)
        if ok then AS.sent = AS.sent + 1 else AS.remoteErr = tostring(err) end
    else
        ok = doClick()
        if ok then AS.shots = AS.shots + 1 else err = "falha no clique" end
    end
    AS.last = now
    local baseMs = C.AsDelay
    if remote then baseMs = math.max(baseMs, fireInterval() * 1050) end
    AS.nextDelay = (baseMs + math.random() * C.AsJitter) / 1000
    AS.state = ok and "atirando" or tostring(err)
end

