-- Extras: agachar (velocidade/sem delay), recarga, cabeca, equipar instantaneo, killfeed e nomes
-- (tudo dentro da tabela NX para nao gastar variaveis locais do arquivo)
--------------------------------------------------------------------------
-- Cabeca: o jogo manda Events.ControlTurn(camera.LookVector.Y, escalando) a ~12 Hz e o servidor inclina a
-- cabeca/cintura para os outros jogadores. Aqui mandamos um Y proprio; o envio original do jogo continua
-- normal (sem hook, nada e bloqueado).
NX.hd = { t = 0, flip = 1, remote = nil, active = false, sent = 0, y = 0, state = "desligado", err = "" }
function NX.hdRemote()
    local hd = NX.hd
    if hd.remote and hd.remote.Parent then return hd.remote end
    local ev = ReplicatedStorage:FindFirstChild("Events")
    hd.remote = ev and ev:FindFirstChild("ControlTurn") or nil
    return hd.remote
end
function NX.hdSend(y)
    local hd = NX.hd
    local r = NX.hdRemote()
    if not r then hd.err = "ControlTurn nao encontrado" return false end
    local ok, e = pcall(function() r:FireServer(y, false) end)
    if ok then hd.sent = hd.sent + 1 hd.y = y return true end
    hd.err = tostring(e)
    return false
end
function NX.headStep()
    local hd = NX.hd
    local char = LP.Character
    if not C.HeadOn or C.Dead or not char or not aliveOf(LP) then
        if hd.active then
            hd.active = false
            local c = cam()
            if c then pcall(NX.hdSend, c.CFrame.LookVector.Y) end
        end
        hd.state = C.HeadOn and "aguardando" or "desligado"
        return
    end
    if not NX.hdRemote() then hd.state = "sem remote" return end
    local now = os.clock()
    local interval = math.max(1 / math.max(C.HeadRate, 1), 0.08)
    if now - hd.t < interval then return end
    hd.t = now
    local r = C.HeadRange / 100
    local y = 0
    if C.HeadMode == "Aleatorio" then y = (math.random() * 2 - 1) * r
    elseif C.HeadMode == "Jitter" then hd.flip = -hd.flip y = r * hd.flip
    elseif C.HeadMode == "Oscilar" then y = math.sin(now * math.pi * 2) * r
    elseif C.HeadMode == "Cima" then y = r
    elseif C.HeadMode == "Baixo" then y = -r end
    hd.active = true
    NX.hdSend(math.clamp(y, -1, 1))
    hd.state = "ativo"
end

-- Equipar instantaneo: acelera/pula a animacao "Equip" do viewmodel (WeaponModule.Animations) e reduz o
-- EquipTime das armas no cliente. O servidor pode ter um tempo proprio que nao da para mudar daqui.
NX.eq = { saved = {}, t = 0, skipped = 0, state = "desligado", err = "", wmT = -10 }
function NX.wmod()
    local eq = NX.eq
    if eq.wm then return eq.wm end
    local now = os.clock()
    if now - eq.wmT < 3 then return nil end
    eq.wmT = now
    local mods = ReplicatedStorage:FindFirstChild("Modules")
    local ms = mods and mods:FindFirstChild("WeaponModule")
    if not ms then eq.err = "ReplicatedStorage.Modules.WeaponModule nao encontrado" return nil end
    local ok, m = pcall(require, ms)
    if ok and type(m) == "table" then eq.wm = m eq.err = "" return m end
    eq.err = "require(WeaponModule) falhou: " .. tostring(m)
    return nil
end
function NX.eqTimes(on)
    local eq = NX.eq
    local we = ReplicatedStorage:FindFirstChild("WeaponEngine")
    local ws = we and we:FindFirstChild("Weapons")
    if not ws then return end
    for _, w in ipairs(ws:GetChildren()) do
        local v = w:FindFirstChild("EquipTime")
        if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
            if on then
                if eq.saved[v] == nil then eq.saved[v] = v.Value end
                if v.Value ~= 0.05 then v.Value = 0.05 end
            elseif eq.saved[v] ~= nil then
                v.Value = eq.saved[v]
            end
        end
    end
    if not on then eq.saved = {} end
end
function NX.eqStep()
    local eq = NX.eq
    if not C.EqOn then
        if next(eq.saved) ~= nil then pcall(NX.eqTimes, false) end
        eq.state = "desligado"
        return
    end
    local now = os.clock()
    if now - eq.t > 1 then
        eq.t = now
        pcall(NX.eqTimes, true)
    end
    local wm = NX.wmod()
    if not wm then eq.state = "sem WeaponModule" return end
    local ok, tr = pcall(function() return wm.Animations.FirstPersonAnimations.Equip end)
    eq.state = "ativo"
    if ok and tr then
        local okp, playing = pcall(function() return tr.IsPlaying end)
        if okp and playing then
            pcall(function() tr:AdjustSpeed(100) end)
            pcall(function() if tr.Length > 0 then tr.TimePosition = tr.Length end end)
            eq.skipped = eq.skipped + 1
        end
    end
end

-- GunConfig.Movement / MovementClassic: CrouchMul (velocidade agachado = WalkSpeed * CrouchMul) e
-- CrouchSpamStep (cada agachada soma ao "crouchcooldown", que deixa o agachar mais lento se spammar).
NX.gc = { mod = nil, saved = {}, t = -10, err = "" }
function NX.gcMod()
    local g = NX.gc
    if g.mod then return g.mod end
    local now = os.clock()
    if now - g.t < 3 then return nil end
    g.t = now
    local mods = ReplicatedStorage:FindFirstChild("Modules")
    local ms = mods and mods:FindFirstChild("GunConfig")
    if not ms then g.err = "ReplicatedStorage.Modules.GunConfig nao encontrado" return nil end
    local ok, m = pcall(require, ms)
    if ok and type(m) == "table" then g.mod = m g.err = "" return m end
    g.err = "require(GunConfig) falhou: " .. tostring(m)
    return nil
end
function NX.gcApply()
    local gm = NX.gcMod()
    if not gm then return false end
    for _, name in ipairs({ "Movement", "MovementClassic" }) do
        local t = gm[name]
        if type(t) == "table" then
            local sv = NX.gc.saved[name]
            if not sv then sv = {} NX.gc.saved[name] = sv end
            local function set(k, want, on)
                if on then
                    if sv[k] == nil then sv[k] = t[k] end
                    t[k] = want
                elseif sv[k] ~= nil then
                    t[k] = sv[k]
                    sv[k] = nil
                end
            end
            set("CrouchMul", 1, C.CrSpeedOn)
            set("CrouchSpamStep", 0, C.CrouchFast)
        end
    end
    return true
end

-- Recarga: instantanea (reduz ReloadTime no cliente e acelera as animacoes Reload*) e automatica
-- (chama WeaponModule:reload(), o mesmo que a tecla de recarregar, quando o pente zera).
NX.rl = { saved = {}, t = 0, last = 0, skipped = 0, auto = 0, state = "desligado", err = "" }
function NX.rlTimes(on)
    local rl = NX.rl
    local we = ReplicatedStorage:FindFirstChild("WeaponEngine")
    local ws = we and we:FindFirstChild("Weapons")
    if not ws then return end
    for _, w in ipairs(ws:GetChildren()) do
        for _, n in ipairs({ "ReloadTime", "SReload", "EReload" }) do
            local v = w:FindFirstChild(n)
            if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
                if on then
                    if rl.saved[v] == nil then rl.saved[v] = v.Value end
                    if v.Value ~= 0.05 then v.Value = 0.05 end
                elseif rl.saved[v] ~= nil then
                    v.Value = rl.saved[v]
                end
            end
        end
    end
    if not on then rl.saved = {} end
end
function NX.reloading()
    local rl = NX.rl
    if not rl.vars or not rl.vars.Parent then
        local pg = LP:FindFirstChild("PlayerGui")
        rl.vars = pg and pg:FindFirstChild("Variables", true) or nil
    end
    local v = rl.vars and rl.vars:FindFirstChild("Reloading")
    return v and v.Value == true
end
function NX.reloadStep()
    local rl = NX.rl
    if not C.IrOn and not C.ArOn then
        if next(rl.saved) ~= nil then pcall(NX.rlTimes, false) end
        rl.state = "desligado"
        return
    end
    local now = os.clock()
    if C.IrOn and now - rl.t > 1 then
        rl.t = now
        pcall(NX.rlTimes, true)
    elseif not C.IrOn and next(rl.saved) ~= nil then
        pcall(NX.rlTimes, false)
    end
    local wm = NX.wmod()
    if not wm then rl.state = "sem WeaponModule" return end
    rl.state = "ativo"
    if C.IrOn then
        local ok, anims = pcall(function() return wm.Animations.FirstPersonAnimations end)
        if ok and type(anims) == "table" then
            for k, tr in pairs(anims) do
                if type(k) == "string" and k:sub(1, 6) == "Reload" then
                    pcall(function()
                        if tr.IsPlaying then
                            tr:AdjustSpeed(100)
                            if tr.Length > 0 then tr.TimePosition = tr.Length end
                            rl.skipped = rl.skipped + 1
                        end
                    end)
                end
            end
        end
    end
    if C.ArOn and now - rl.last > 0.6 and aliveOf(LP) then
        local w = weaponOf(LP)
        local inv = LP:FindFirstChild("Inventory")
        local item = inv and inv:FindFirstChild(w)
        local ammo = item and childVal(item, "Ammo")
        local stored = item and childVal(item, "StoredAmmo")
        if w ~= "Knife" and type(ammo) == "number" and ammo <= 0 and (type(stored) ~= "number" or stored > 0) and not NX.reloading() then
            rl.last = now
            local okr, e = pcall(function() wm:reload() end)
            if okr then
                rl.auto = rl.auto + 1
            else
                rl.err = "reload falhou: " .. tostring(e)
                local vim = getVIM()
                if vim then pcall(function()
                    vim:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                    vim:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                end) end
            end
        end
    end
end

-- Killfeed e nomes (placar). Os textos sao trocados no seu cliente; so voce ve.
--   killfeed: Frame "Killfeed" (esconder) e TextLabel "Name" dentro dele
--   placar: TextLabel "Text" dentro de um Frame chamado "Name" (o jogo so reescreve se o texto mudar,
--   entao o sinal Text de cada label recoloca o nosso).
NX.lbl = setmetatable({}, { __mode = "k" })
NX.nm = { kfHost = nil, kfT = 0, kfHidden = false, scanT = 0, hooked = false, count = 0 }
function NX.kindOf(l)
    if not l:IsA("TextLabel") then return nil end
    local p = l.Parent
    if l.Name == "Name" and l:FindFirstAncestor("Killfeed") then return "kf" end
    if l.Name == "Text" and p and p.Name == "Name" then return "sb" end
    return nil
end
function NX.want(kind, text)
    local mode = (kind == "kf") and C.KfMode or C.SbMode
    if mode == "Normal" or mode == "Esconder killfeed" then return nil end
    if C.NameWho == "So eu" then
        local t = string.lower(text)
        if t ~= string.lower(LP.Name) and t ~= string.lower(LP.DisplayName) then return nil end
    end
    if mode == "Esconder nomes" then return "???" end
    if mode == "Nome: Personalizado" then
        local c = (kind == "kf") and C.KfCustom or C.SbCustom
        if c ~= "" then return c end
    end
    return "memesense"
end
function NX.apply(l, kind)
    local info = NX.lbl[l]
    if not info then
        info = { kind = kind }
        NX.lbl[l] = info
        info.conn = l:GetPropertyChangedSignal("Text"):Connect(function() pcall(NX.apply, l, kind) end)
    end
    local cur = l.Text
    if info.set and cur == info.set then
        local w = NX.want(kind, info.orig)
        if w == info.set then return end
        if w then
            info.set = w
            l.Text = w
        else
            info.set = nil
            l.Text = info.orig
        end
        return
    end
    local w = NX.want(kind, cur)
    if w then
        info.orig, info.set = cur, w
        l.Text = w
        NX.nm.count = NX.nm.count + 1
    else
        info.set = nil
    end
end
function NX.nameActive()
    return C.KfMode == "Nome: Memesense" or C.KfMode == "Nome: Personalizado" or C.SbMode == "Esconder nomes"
        or C.SbMode == "Nome: Memesense" or C.SbMode == "Nome: Personalizado"
end
function NX.scan()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end
    local nm = NX.nm
    if not nm.hooked then
        nm.hooked = true
        conn(pg.DescendantAdded, function(d)
            if C.Dead then return end
            pcall(function()
                if d:IsA("TextLabel") then
                    local k = NX.kindOf(d)
                    if k then NX.apply(d, k) end
                end
            end)
        end)
    end
    local tracked = next(NX.lbl) ~= nil
    if not NX.nameActive() and not tracked then return end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextLabel") then
            local k = NX.kindOf(d)
            if k then pcall(NX.apply, d, k) end
        end
    end
end
function NX.nameStep()
    local nm = NX.nm
    local now = os.clock()
    if C.KfMode == "Esconder killfeed" then
        local h = nm.kfHost
        if (not h or not h.Parent) and now - nm.kfT > 1 then
            nm.kfT = now
            local pg = LP:FindFirstChild("PlayerGui")
            h = pg and pg:FindFirstChild("Killfeed", true)
            nm.kfHost = h
        end
        if h and h.Parent then
            if h.Visible then h.Visible = false end
            nm.kfHidden = true
        end
    elseif nm.kfHidden then
        nm.kfHidden = false
        if nm.kfHost and nm.kfHost.Parent then nm.kfHost.Visible = true end
    end
    if now - nm.scanT > 1 then
        nm.scanT = now
        NX.scan()
    end
end

function NX.step()
    pcall(NX.headStep)
    pcall(NX.eqStep)
    pcall(NX.reloadStep)
    pcall(NX.nameStep)
    local cr = LP.Character and LP.Character:FindFirstChild("Crouched") and true or false
    if cr ~= NX.cr then
        NX.cr = cr
        if C.CrSpeedOn then pcall(mvApply) end
    end
end
function NX.restore()
    C.HeadOn, C.EqOn, C.IrOn, C.ArOn, C.CrSpeedOn, C.CrouchFast = false, false, false, false, false, false
    pcall(NX.gcApply)
    pcall(mvApply)
    C.KfMode, C.SbMode = "Normal", "Normal"
    pcall(NX.headStep)
    pcall(NX.eqStep)
    pcall(NX.reloadStep)
    pcall(NX.nameStep)
    pcall(NX.scan)
end
conn(RunService.Heartbeat, function() pcall(NX.step) end)

