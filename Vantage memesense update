local function circleUpdate(circle, stroke, on, deg, color, origin)
    if not on then circle.Visible = false return end
    local r = fovPx(deg)
    if r > 3000 then circle.Visible = false return end
    local o = aimOrigin(origin)
    circle.Size = UDim2.fromOffset(r * 2, r * 2)
    circle.Position = UDim2.fromOffset(o.X, o.Y)
    stroke.Color = color
    circle.Visible = true
end

local BIND = "VH_Main"
RunService:BindToRenderStep(BIND, Enum.RenderPriority.Camera.Value + 1, function()
    local now = os.clock()
    for _, o in pairs(ESP) do
        local ok = pcall(updateESP, o, now)
        if not ok then pcall(hideESP, o) end
    end
    circleUpdate(aimCircle, aimStroke, C.AimOn and C.AimShowFov, C.AimFov, C.AimFovColor, C.AimFovOrigin)
    circleUpdate(asCircle, asStroke, C.AsOn and C.AsShowFov and C.AsMode ~= "360", C.AsFov, C.AsFovColor, C.AsFovOrigin)
    pcall(aimStep)
    pcall(asStep)
end)

